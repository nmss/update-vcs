{
	"root": true,
	"env": {
		"es6": true,
		"node": true
	},
	"parserOptions": {
		"ecmaVersion": 2022,
		"sourceType": "module"
	},
	"extends": "eslint:recommended",
	"rules": {
		"no-console": "off",
		"no-extend-native": "error",
		"no-implied-eval": "error",
		"no-loop-func": "warn",
		"semi": "warn",
		"semi-spacing": "warn"
	}
}
